{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/mcp/gateway-session.schema.json",
  "title": "MCP Gateway Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "client_id",
    "principal_id",
    "allowed_tool_keys",
    "scope_constraints",
    "issued_permission_set_version",
    "status",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "client_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "principal_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "agent_run_id": { "type": ["string", "null"], "maxLength": 64 },
    "workspace_key": {
      "type": ["string", "null"],
      "enum": ["executive", "manager", "operator", "service", "finance", "people", "data-governance", "platform-ops", "ai-ops", null]
    },
    "allowed_tool_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "scope_constraints": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_type", "scope_ids"],
        "properties": {
          "scope_type": {
            "enum": [
              "enterprise",
              "org_subtree",
              "store",
              "knowledge_space",
              "object",
              "self",
              "business_unit"
            ]
          },
          "scope_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        }
      }
    },
    "issued_permission_set_version": { "type": "string", "minLength": 1, "maxLength": 120 },
    "current_permission_set_version": { "type": ["string", "null"], "maxLength": 120 },
    "status": { "enum": ["active", "expired", "revoked"] },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "last_seen_at": { "type": ["string", "null"], "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
