{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/identity/access-role-configuration.schema.json",
  "title": "Governed Access Role Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client_request_key", "name", "description", "permissions", "reason"],
  "properties": {
    "schema_version": { "const": 1 },
    "client_request_key": { "type": "string", "minLength": 8, "maxLength": 160 },
    "role_key": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "expected_revision": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 2, "maxLength": 160 },
    "description": { "type": "string", "minLength": 3, "maxLength": 500 },
    "status": { "enum": ["active", "suspended"] },
    "permissions": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
    "reason": { "type": "string", "minLength": 3, "maxLength": 500 }
  }
}
