{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/agent-runtime/skill-registry.schema.json",
  "title": "Enterprise Skill registry and version",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_mode", "stats", "skills", "available_tools"],
  "properties": {
    "schema_version": { "const": 1 },
    "data_mode": { "const": "database" },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_count", "published_skill_count", "draft_version_count", "published_version_count", "registered_tool_count"],
      "properties": {
        "skill_count": { "type": "integer", "minimum": 0 },
        "published_skill_count": { "type": "integer", "minimum": 0 },
        "draft_version_count": { "type": "integer", "minimum": 0 },
        "published_version_count": { "type": "integer", "minimum": 0 },
        "registered_tool_count": { "type": "integer", "minimum": 0 }
      }
    },
    "available_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key", "name", "description", "status", "current_version_number", "versions", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "status": { "enum": ["draft", "published", "retired"] },
          "current_version_number": { "type": ["integer", "null"], "minimum": 1 },
          "created_by": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version_number", "status", "instructions", "tool_keys", "input_schema", "output_schema", "change_summary", "created_at"],
              "properties": {
                "id": { "type": "string" },
                "version_number": { "type": "integer", "minimum": 1 },
                "status": { "enum": ["draft", "published", "retired"] },
                "instructions": { "type": "string", "minLength": 10 },
                "tool_keys": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "input_schema": { "type": "object" },
                "output_schema": { "type": "object" },
                "change_summary": { "type": "string" },
                "created_by": { "type": ["string", "null"] },
                "created_at": { "type": "string", "format": "date-time" },
                "published_at": { "type": ["string", "null"], "format": "date-time" }
              }
            }
          }
        }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
