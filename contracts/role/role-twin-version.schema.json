{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/role/role-twin-version.schema.json",
  "title": "Versioned role twin configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "twin_key",
    "template_key",
    "owner_principal_key",
    "version_number",
    "status",
    "display_name",
    "voice_guide",
    "reasoning_guide",
    "answer_policy",
    "provider",
    "model",
    "capabilities",
    "change_summary"
  ],
  "properties": {
    "twin_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "template_key": { "type": "string" },
    "owner_principal_key": { "type": ["string", "null"] },
    "version_number": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "published", "retired"] },
    "display_name": { "type": "string" },
    "voice_guide": { "type": "string" },
    "reasoning_guide": { "type": "string" },
    "answer_policy": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "change_summary": { "type": "string" }
  }
}
