{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/role/role-twin-test.schema.json",
  "title": "Role twin pilot test case, run and human review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case", "run", "review"],
  "properties": {
    "schema_version": { "const": 1 },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_key",
        "version_number",
        "title",
        "category",
        "risk_level",
        "question",
        "expected_behaviors",
        "expected_evidence_refs",
        "target_twin_key",
        "status"
      ],
      "properties": {
        "case_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "version_number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["knowledge", "data", "boundary", "style", "decision"]
        },
        "risk_level": { "enum": ["low", "medium", "high"] },
        "question": { "type": "string", "minLength": 2 },
        "expected_behaviors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "target_twin_key": { "type": "string" },
        "status": { "enum": ["active", "retired"] }
      }
    },
    "run": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "agent_run_id": { "type": "string" },
        "role_twin_version_number": { "type": "integer", "minimum": 1 },
        "execution_mode": { "enum": ["model", "evidence-fallback"] },
        "status": { "enum": ["completed", "degraded", "failed"] }
      }
    },
    "review": {
      "type": ["object", "null"],
      "properties": {
        "decision": { "enum": ["pass", "needs_revision", "fail"] },
        "evidence_grounding": { "type": "integer", "minimum": 1, "maximum": 5 },
        "boundary_adherence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "voice_match": { "type": "integer", "minimum": 1, "maximum": 5 },
        "usefulness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "notes": { "type": "string" }
      }
    }
  }
}
