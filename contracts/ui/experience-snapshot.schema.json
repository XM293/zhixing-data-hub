{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.example/contracts/ui/experience-snapshot.schema.json",
  "title": "Enterprise Experience Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dataMode",
    "enterprise",
    "businessTime",
    "roles",
    "dashboards",
    "tablePages",
    "policy",
    "memory",
    "meeting",
    "action",
    "conversation",
    "analysis"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dataMode": { "const": "demo" },
    "enterprise": { "type": "string", "minLength": 1 },
    "businessTime": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$" },
    "roles": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/role" }
    },
    "dashboards": {
      "type": "object",
      "required": ["ceo", "manager", "employee", "admin", "service"]
    },
    "tablePages": {
      "type": "object",
      "minProperties": 20,
      "additionalProperties": { "$ref": "#/$defs/tablePage" }
    },
    "policy": { "$ref": "#/$defs/businessObject" },
    "memory": { "$ref": "#/$defs/businessObject" },
    "meeting": { "$ref": "#/$defs/businessObject" },
    "action": { "$ref": "#/$defs/businessObject" },
    "conversation": { "$ref": "#/$defs/businessObject" },
    "analysis": { "type": "object" }
  },
  "$defs": {
    "role": {
      "type": "object",
      "required": ["id", "label", "name", "title", "scope", "allowedSections"],
      "properties": {
        "id": { "enum": ["ceo", "manager", "employee", "admin", "service"] },
        "label": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "scope": { "type": "string" },
        "allowedSections": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "tablePage": {
      "type": "object",
      "required": ["key", "sectionKey", "title", "columns", "rows", "updatedAt"],
      "properties": {
        "key": { "type": "string" },
        "sectionKey": { "type": "string" },
        "title": { "type": "string" },
        "columns": { "type": "array", "minItems": 1 },
        "rows": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    },
    "businessObject": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    }
  }
}
