{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.example/contracts/ui/module-manifest.schema.json",
  "title": "UI Module Manifest",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["moduleKey", "navigationKey", "route", "label", "iconKey", "deliveryState", "dataMode"],
    "properties": {
      "moduleKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "navigationKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "route": { "type": "string", "pattern": "^/console(?:/.*)?$" },
      "label": { "type": "string", "minLength": 1 },
      "iconKey": { "type": "string", "minLength": 1 },
      "requiredCapability": { "type": "string" },
      "deliveryState": { "enum": ["prototype", "implemented", "unavailable"] },
      "dataMode": { "enum": ["demo", "live"] }
    }
  }
}
