{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/analysis/store-review-plan.schema.json",
  "title": "StoreReviewPlanRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "scope_key", "window_days", "timezone", "local_time", "weekdays", "auto_propose_min_priority", "client_request_key"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "scope_key": { "type": "string", "minLength": 2, "maxLength": 160 },
    "window_days": { "type": "integer", "minimum": 7, "maximum": 90 },
    "timezone": { "type": "string", "minLength": 3, "maxLength": 64 },
    "local_time": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
    "weekdays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 7 }
    },
    "auto_propose_min_priority": {
      "type": "string",
      "enum": ["off", "urgent", "high"]
    },
    "client_request_key": { "type": "string", "minLength": 8, "maxLength": 160 }
  }
}
