{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/customer-service/reply-draft.schema.json",
  "title": "CustomerServiceReplyDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "enterprise_id",
    "conversation_id",
    "version_number",
    "status",
    "body",
    "risk_level",
    "risk_flags",
    "safe_to_send",
    "suggested_action",
    "provider",
    "model",
    "execution_mode",
    "evidence_snapshot_id",
    "agent_run_id",
    "role_twin_version_id",
    "created_by_principal_id",
    "idempotency_key",
    "request_id",
    "run_id",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "enterprise_id": { "type": "string", "minLength": 3, "maxLength": 64 },
    "conversation_id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "version_number": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["generated", "sandbox_sent", "rejected", "superseded"] },
    "body": { "type": "string", "minLength": 2, "maxLength": 4000 },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "risk_flags": {
      "type": "array",
      "items": {
        "enum": [
          "compensation_commitment",
          "refund_timeline",
          "unverified_logistics",
          "safety_or_complaint",
          "legal_or_media",
          "personal_data",
          "manual_request",
          "data_conflict",
          "other"
        ]
      }
    },
    "safe_to_send": { "type": "boolean" },
    "suggested_action": { "enum": ["reply", "investigate", "handoff"] },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(D|K)[1-9][0-9]*$" }
    },
    "provider": { "type": "string", "maxLength": 64 },
    "model": { "type": "string", "maxLength": 120 },
    "execution_mode": { "enum": ["model", "evidence-fallback"] },
    "fallback_reason": { "type": ["string", "null"], "maxLength": 1000 },
    "evidence_snapshot_id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "agent_run_id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "role_twin_version_id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "created_by_principal_id": { "type": "string", "minLength": 3, "maxLength": 64 },
    "approved_by_principal_id": { "type": ["string", "null"], "maxLength": 64 },
    "approval_note": { "type": ["string", "null"], "maxLength": 1000 },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 160 },
    "request_id": { "type": "string", "minLength": 8, "maxLength": 96 },
    "run_id": { "type": "string", "minLength": 8, "maxLength": 96 },
    "created_at": { "type": "string", "format": "date-time" },
    "approved_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
