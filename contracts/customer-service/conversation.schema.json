{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/customer-service/conversation.schema.json",
  "title": "CustomerServiceConversation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "enterprise_id",
    "conversation_key",
    "channel_key",
    "source_system_key",
    "customer_key",
    "customer_name",
    "store_scope_key",
    "topic",
    "status",
    "priority",
    "sentiment",
    "risk_level",
    "risk_reason",
    "last_message_at",
    "first_response_due_at",
    "latest_sync_at",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "enterprise_id": { "type": "string", "minLength": 3, "maxLength": 64 },
    "conversation_key": { "type": "string", "minLength": 3, "maxLength": 120 },
    "channel_key": { "type": "string", "minLength": 2, "maxLength": 64 },
    "external_conversation_id": { "type": ["string", "null"], "maxLength": 160 },
    "source_system_key": { "type": "string", "minLength": 2, "maxLength": 100 },
    "customer_key": { "type": "string", "minLength": 2, "maxLength": 160 },
    "customer_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "order_key": { "type": ["string", "null"], "maxLength": 160 },
    "store_scope_key": { "type": "string", "minLength": 2, "maxLength": 160 },
    "topic": { "type": "string", "minLength": 2, "maxLength": 240 },
    "status": {
      "enum": ["waiting", "draft_ready", "review_required", "handed_off", "resolved"]
    },
    "priority": { "enum": ["normal", "high", "urgent"] },
    "sentiment": { "enum": ["calm", "concerned", "angry"] },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "risk_reason": { "type": "string", "maxLength": 1000 },
    "assigned_principal_id": { "type": ["string", "null"], "maxLength": 64 },
    "last_message_at": { "type": "string", "format": "date-time" },
    "first_response_due_at": { "type": "string", "format": "date-time" },
    "latest_sync_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
