{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/data/lingxing-official-contract.schema.json",
  "title": "Extracted Lingxing official read contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "source", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "source": {"const": "https://apidoc.lingxing.com/_sidebar.md"},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "path", "wave", "documentation_url", "document_sha256",
          "retrieved_sha256", "request_fields", "response_fields", "required_fields",
          "scope_fields", "pagination_mode", "window_fields", "rows_path",
          "window_format", "total_path", "rate_capacity", "max_window_days",
          "retention_days", "extraction_status"],
        "properties": {
          "id": {"type": "string", "pattern": "^lingxing_op_[0-9a-f]{16}$"},
          "method": {"enum": ["GET", "POST"]},
          "path": {"type": "string", "pattern": "^/"},
          "wave": {"enum": ["W0", "W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8"]},
          "documentation_url": {"type": "string", "pattern": "^https://apidoc\\.lingxing\\.com/"},
          "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "retrieved_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "request_fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
          "response_fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
          "required_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "scope_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "pagination_mode": {"enum": ["none", "offset_length", "offset_limit", "page", "unknown"]},
          "window_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "window_format": {"enum": ["date", "datetime", "unknown"]},
          "rows_path": {"type": "array", "items": {"type": "string"}},
          "total_path": {"type": "array", "items": {"type": "string"}},
          "rate_capacity": {"type": ["integer", "null"], "minimum": 1},
          "max_window_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 366},
          "retention_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 3660},
          "extraction_status": {"enum": ["confirmed", "schema_pending", "document_changed"]}
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "required", "type", "description"],
      "properties": {
        "path": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "name": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "type": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    }
  }
}
