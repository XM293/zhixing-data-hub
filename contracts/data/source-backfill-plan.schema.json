{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/data/source-backfill-plan.schema.json",
  "title": "Source backfill plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "resource_key", "resource_parameters", "projection_mode", "status",
    "window_start", "window_end", "cursor", "partition_days", "batch_size",
    "active_run_id", "windows_total", "windows_succeeded", "windows_no_data",
    "windows_with_conflicts", "windows_failed", "records_read", "records_written",
    "error_code", "version"
  ],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "resource_key": {"type": "string"},
    "resource_parameters": {"type": "object", "additionalProperties": {"type": "string"}},
    "projection_mode": {"enum": ["inline", "deferred"]},
    "status": {"enum": ["paused", "active", "completed", "needs_attention", "cancelled"]},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "cursor": {"type": "string", "format": "date-time"},
    "partition_days": {"type": "integer", "minimum": 1, "maximum": 7},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 32},
    "active_run_id": {"type": ["string", "null"]},
    "windows_total": {"type": "integer", "minimum": 1},
    "windows_succeeded": {"type": "integer", "minimum": 0},
    "windows_no_data": {"type": "integer", "minimum": 0},
    "windows_with_conflicts": {"type": "integer", "minimum": 0},
    "windows_failed": {"type": "integer", "minimum": 0},
    "records_read": {"type": "integer", "minimum": 0},
    "records_written": {"type": "integer", "minimum": 0},
    "error_code": {"type": ["string", "null"]},
    "version": {"type": "integer", "minimum": 1}
  }
}
