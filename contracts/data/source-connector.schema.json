{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/data/source-connector.schema.json",
  "title": "Customer source connector sync contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_schema_version", "mapping_version", "mode", "resources", "completed"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_schema_version": { "type": "string", "minLength": 1 },
    "mapping_version": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["full", "incremental", "backfill"] },
    "completed": { "type": "boolean" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "status", "fetched_count", "accepted_count", "source_schema_version", "mapping_version", "retryable"],
        "properties": {
          "resource": { "type": "string", "minLength": 1 },
          "status": { "enum": ["succeeded", "partial", "failed", "skipped"] },
          "fetched_count": { "type": "integer", "minimum": 0 },
          "accepted_count": { "type": "integer", "minimum": 0 },
          "cursor": { "type": ["object", "null"] },
          "source_schema_version": { "type": "string", "minLength": 1 },
          "mapping_version": { "type": "string", "minLength": 1 },
          "error_code": { "type": ["string", "null"] },
          "retryable": { "type": "boolean" }
        }
      }
    }
  }
}
