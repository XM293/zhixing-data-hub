{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/data/customer-profile-detail.schema.json",
  "title": "Customer profile detail response",
  "type": "object",
  "required": [
    "schema_version",
    "data_mode",
    "scope_key",
    "customer_key",
    "recommendation_mode",
    "playbook_version",
    "profile",
    "summary",
    "recommendations",
    "timeline",
    "orders",
    "refunds",
    "touchpoints",
    "lineage",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "data_mode": { "const": "database" },
    "scope_key": { "type": "string", "minLength": 1 },
    "customer_key": { "type": "string", "minLength": 1 },
    "recommendation_mode": { "const": "deterministic_playbook" },
    "playbook_version": { "type": "string", "minLength": 1 },
    "profile": { "type": "object" },
    "summary": { "type": "object" },
    "recommendations": { "type": "array" },
    "timeline": { "type": "array" },
    "orders": { "type": "array" },
    "refunds": { "type": "array" },
    "touchpoints": { "type": "array" },
    "lineage": { "type": "array" },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
