{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/metric/metric-query.schema.json",
  "title": "Metric time-series query",
  "type": "object",
  "additionalProperties": false,
  "required": ["metric_keys", "scope_key", "days", "granularity"],
  "properties": {
    "metric_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "scope_key": { "type": "string", "minLength": 1, "maxLength": 160 },
    "days": { "type": "integer", "minimum": 1, "maximum": 365 },
    "as_of": { "type": ["string", "null"], "format": "date-time" },
    "granularity": { "const": "day" }
  }
}
