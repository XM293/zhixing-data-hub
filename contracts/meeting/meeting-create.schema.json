{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhixing.local/contracts/meeting/meeting-create.schema.json",
  "title": "Decision Meeting Create Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client_request_key",
    "template_key",
    "title",
    "topic",
    "scope_type",
    "scope_key",
    "success_metric",
    "participant_keys"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "client_request_key": { "type": "string", "minLength": 8, "maxLength": 160 },
    "template_key": {
      "enum": [
        "budget-inventory-review",
        "inventory-clearance-review",
        "kpi-incentive-review"
      ]
    },
    "title": { "type": "string", "minLength": 4, "maxLength": 240 },
    "topic": { "type": "string", "minLength": 10, "maxLength": 500 },
    "scope_type": { "enum": ["enterprise", "store"] },
    "scope_key": { "type": "string", "minLength": 2, "maxLength": 160 },
    "success_metric": { "type": "string", "minLength": 6, "maxLength": 500 },
    "deadline_at": { "type": ["string", "null"], "format": "date-time" },
    "participant_keys": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^twin-[a-z0-9-]+$" }
    },
    "workspace_key": {
      "type": ["string", "null"],
      "enum": ["executive", "manager", "operator", "service", "finance", "people", "data-governance", "platform-ops", "ai-ops", null]
    }
  }
}
