# Public application configuration
APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
SEED_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=https://api.zhixing.maysu.com
API_CORS_ORIGINS=https://zhixing.maysu.com

# Managed PostgreSQL; inject the value through the deployment secret manager.
DATABASE_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_AUTO_MIGRATE=false

# S3-compatible object storage; the bucket must exist before startup.
FILE_ASSET_STORAGE_PROVIDER=s3
FILE_ASSET_STORAGE_PATH=/var/lib/zhixing/legacy-file-assets
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_AUTO_CREATE_BUCKET=false

# Managed Redis coordinates multi-instance schedulers.
REDIS_ENABLED=true
REDIS_URL=
REDIS_KEY_PREFIX=zhixing-production

# Responses-compatible model provider. Prefer a service account secret.
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_TIMEOUT_SECONDS=90

# Codex Runtime remains behind the enterprise API and constrained MCP session.
AGENT_RUNTIME_ENABLED=true
CODEX_COMMAND=codex
CODEX_RUNTIME_MODEL=
CODEX_RUNTIME_TIMEOUT_SECONDS=60
CODEX_RUNTIME_CWD=/srv/zhixing/runtime
CODEX_RUNTIME_MCP_CLIENT_ID=codex-production
CODEX_RUNTIME_MCP_TTL_SECONDS=900

# Optional providers stay disabled until a real endpoint and credential are supplied.
MEMORY_PROVIDER_MODE=disabled
KNOWLEDGE_PROVIDER_MODE=disabled
TENCENTDB_MEMORY_BASE_URL=
TENCENTDB_MEMORY_API_KEY=
MEM0_BASE_URL=
MEM0_API_KEY=
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
WEKNORA_KNOWLEDGE_BASE_ID=
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
OPENVIKING_BASE_URL=
OPENVIKING_API_KEY=
OPENVIKING_ACCOUNT=
OPENVIKING_USER=

# Authentication and integrations are injected as secrets at deployment time.
AUTH_BOOTSTRAP_PASSWORD=
AUTH_SESSION_TTL_SECONDS=28800
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Worker
WORKER_ID=
WORKER_API_BASE_URL=http://api:8000
WORKER_API_TIMEOUT_SECONDS=110
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=30
WORKER_RETRY_DELAY_SECONDS=1
WORKER_SCHEMA_WAIT_SECONDS=60
WORKER_DATABASE_POOL_SIZE=10
WORKER_DATABASE_MAX_OVERFLOW=20
WORKER_DATABASE_POOL_TIMEOUT_SECONDS=30
WORKER_DATABASE_POOL_RECYCLE_SECONDS=900
