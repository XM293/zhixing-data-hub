[Unit]
Description=Zhixing API
After=network-online.target

[Service]
WorkingDirectory=/opt/zhixing-data-hub
EnvironmentFile=/etc/zhixing/zhixing.env
ExecStart=/opt/zhixing-data-hub/.venv/bin/uvicorn zhixing_api.main:app --app-dir services/api/src --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
