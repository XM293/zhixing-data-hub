APP_ENV=staging
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite+pysqlite:////var/lib/zhixing/zhixing.db
DATABASE_AUTO_MIGRATE=true
SEED_ENABLED=true
FILE_ASSET_STORAGE_PROVIDER=local
FILE_ASSET_STORAGE_PATH=/var/lib/zhixing/assets
AI_ENABLED=false
AGENT_RUNTIME_ENABLED=false
MEMORY_PROVIDER_MODE=disabled
KNOWLEDGE_PROVIDER_MODE=disabled
REDIS_ENABLED=false
API_CORS_ORIGINS=http://127.0.0.1
AUTH_BOOTSTRAP_PASSWORD=
